# Node / TypeScript monorepo (apps/, packages/)
node_modules/
dist/
.next/
*.tsbuildinfo
.env.local
.env*.local

# apps/api-saas's Prisma client is generated to its own path (not the shared
# node_modules/.prisma/client apps/api-byoc uses) to avoid the two schemas
# overwriting each other's generated client — see prisma/schema.prisma.
apps/api-saas/generated/

