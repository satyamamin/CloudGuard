# Node / TypeScript monorepo (apps/, packages/)
node_modules/
dist/
.next/
*.tsbuildinfo
.env.local
.env*.local

# Generated Prisma clients are build artifacts, not source -- regenerated by
# `prisma generate` (apps/api-byoc/Dockerfile runs it explicitly during the
# image build; local dev via the documented `npx prisma generate` command).
# apps/api-saas isn't in the working tree today (see CLAUDE.md's "SaaS tier"
# section) but its entry is harmless to keep for whenever it's resumed.
apps/api-saas/generated/
apps/api-byoc/src/generated/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfvars.backup
.terraform.lock.hcl
crash.log
override.tf
override.tf.json

# Secrets
.env
*.env
secrets.*
**/terraform.tfvars
docs/Internal integration secret.txt

# dev-test/set-mode.ps1's per-mode env templates (real DB passwords, Clerk
# secret keys) -- named *.dev-local/*.dev-azure so they don't collide with
# .env/.env.local, which the mode switch script also writes to.
.env.dev-local
.env.dev-azure

# Python
__pycache__/
*.pyc
.venv/

# Logs
*.log

# OS
Thumbs.db
.DS_Store
