# Postgres connection string. Exactly one of the two lines below should be
# uncommented at a time — comment/uncomment to switch which database this
# instance talks to. apps/api-byoc reads this from the real shell
# environment, not this file directly (see CLAUDE.md) — restart after
# switching.

# LOCAL — docker-compose.dev.yml's postgres container.
DATABASE_URL="postgresql://cloudguard:cloudguard@localhost:5432/cloudguard?schema=public"

# AZURE — the Flexible Server provisioned alongside a deployed Container App
# (see infra/bicep). sslmode=require is mandatory — Flexible Server rejects
# unencrypted connections.
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require"

# Shared secret the frontend pairs with. In production this is generated by
# the Bicep template (see infra/bicep) and shown to the customer once as a
# deployment output. Any value works for local dev.
API_KEY="dev-local-api-key"

# managed-identity: used inside the deployed Container App (DefaultAzureCredential
#   resolves the system-assigned Managed Identity automatically).
# cli: used for local dev — requires `az login`; falls back to AzureCliCredential
#   so Azure calls run under your own RBAC-assigned permissions.
AZURE_AUTH_MODE="cli"

# Locks down CORS to the CloudGuard frontend origin(s). Comma-separated for
# multiple (e.g. local dev also allowing dev-test/viewer on :5500).
# Never "*".
FRONTEND_ORIGIN="http://localhost:3000"

PORT=3001

# Dev-only. When "true", /costs/daily, /costs/by-service and /costs/by-resource
# (and /costs/accumulated, which derives from /costs/daily) return deterministic
# canned data instead of calling Azure Cost Management — skips AZURE_AUTH_MODE
# entirely for those endpoints. Useful for dashboard UI work without burning
# Azure's per-subscription throttle quota (see CLAUDE.md). Leave unset/false to
# hit real Azure.
# USE_MOCK_COST_DATA=true

# Minutes to cache each Cost Management query (daily/by-service/by-resource/sync
# all share this, keyed per subscription+range — see CostManagementService).
# Defaults to 240 (4h) if unset — cost data already lags Azure-side by up to
# 24h, so a long TTL costs nothing in freshness while cutting 429 risk. Lower
# this locally if you need fresher data while iterating.
# COST_CACHE_TTL_MINUTES=240

# Days of history a /costs/* call returns when the caller omits ?days=.
# Defaults to 30 if unset.
# DEFAULT_COST_DAYS=30

# Optional. When set, AzureQuotaExceededFilter reports Azure Cost Management
# 429s (subscription-scoped throttling) to Sentry as a "warning"-level event
# tagged with azureSubscriptionId/endpoint/retryAfterSeconds. Unset locally —
# falls back to an equivalent console.warn, so this ships without requiring
# a Sentry account to exist yet.
# SENTRY_DSN=
