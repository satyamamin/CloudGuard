# Neon connection string for the APP's runtime — must be a role WITHOUT
# BYPASSRLS, or the azure_connection RLS policy is silently inert. This is
# not a hypothetical: Neon's default role (neon_superuser, which every role
# created via the Neon console/API/CLI inherits) has included BYPASSRLS
# since Aug 2023. Create a separate, restricted Neon role for this var —
# see apps/api-saas/local-dev-init.sql for the local equivalent
# (cloudguard_app). Pin the Neon project to an EU region to keep
# tenant/connection metadata consistent with BYOC's EU-residency framing
# (see docs/cloudguard-hosted.md). Unlike apps/api, this database is shared
# across every SaaS-tier customer — real multi-tenancy, not physical
# isolation.
DATABASE_URL="postgresql://cloudguard_app:cloudguard_app@localhost:5433/cloudguard_saas?schema=public"

# Separate, elevated connection string used ONLY for running migrations
# (`prisma migrate deploy`) — never by the running app. Needs table-owner
# privileges to create/alter tables and RLS policies; on Neon this is the
# default neon_superuser-derived role. Locally this is the postgres-saas
# container's bootstrap role. Not read by apps/api-saas at runtime — pass it
# explicitly when running migrations (see package.json's prisma:migrate:*
# scripts / the release-phase CI step in docs/cloudguard-hosted.md).
MIGRATE_DATABASE_URL="postgresql://cloudguard:cloudguard@localhost:5433/cloudguard_saas?schema=public"

# Verifies the Clerk session JWT apps/web forwards on this org's behalf (see
# src/auth/clerk-auth.guard.ts). Same Clerk application as apps/web.
CLERK_SECRET_KEY=""

# Defense-in-depth: shared secret apps/web's server-side route handlers send
# alongside the Clerk JWT. Leave unset locally to skip the check; must be set
# in any real deployment. See docs/cloudguard-hosted.md's auth model.
SAAS_INTERNAL_SECRET=""

# Locks down CORS to the CloudGuard frontend origin(s). Comma-separated.
# Never "*".
FRONTEND_ORIGIN="http://localhost:3000"

PORT=3002
