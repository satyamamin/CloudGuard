// Multi-tenant schema for the SaaS tier: unlike apps/api's single-customer,
// physically-isolated Instance model, this is one shared Neon database
// serving every SaaS-tier customer — isolation is row-level (tenantId), not
// physical. See docs/cloudguard-hosted.md.

// Explicit output path: without it, this generator would write into the
// same hoisted node_modules/.prisma/client that apps/api's generator also
// targets (npm workspaces hoist a shared @prisma/client install), and the
// two schemas would silently overwrite each other's generated client —
// exactly the kind of cross-contamination that must never touch apps/api.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider  = "postgresql"
  // Runtime client: a restricted role WITHOUT BYPASSRLS (see .env.example
  // and local-dev-init.sql) — required for the azure_connection RLS policy
  // to actually apply, not just exist.
  url       = env("DATABASE_URL")
  // Migrations only (`prisma migrate dev`/`deploy` use this automatically
  // when set, the app's runtime client never does): an elevated role that
  // owns the tables and can create RLS policies.
  directUrl = env("MIGRATE_DATABASE_URL")
}

// One row per Clerk organization using the SaaS tier, keyed by clerkOrgId so
// callers never need a separate "which Clerk org is this" lookup table.
model Tenant {
  id          String            @id @default(cuid())
  clerkOrgId  String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  connections AzureConnection[]

  @@map("tenant")
}

enum ConnectionStatus {
  PENDING_CONSENT
  PENDING_ROLE_ASSIGNMENT
  ACTIVE
  ERROR
  REVOKED
}

// One row per Azure tenant a customer has connected via the multi-tenant App
// Registration flow (docs/cloudguard-hosted.md). No secret/credential column —
// the credential is one CloudGuard-owned client cert (env var), reused
// across every connection; only azureTenantId varies per row.
model AzureConnection {
  id                        String            @id @default(cuid())
  tenantId                  String
  tenant                    Tenant            @relation(fields: [tenantId], references: [id])
  azureTenantId             String
  consentGrantedAt          DateTime?
  roleAssignmentConfirmedAt DateTime?
  status                    ConnectionStatus  @default(PENDING_CONSENT)
  selectedSubscriptionIds   String[]          @default([])
  lastSyncedAt              DateTime?
  lastSyncError             String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([tenantId])
  @@map("azure_connection")
}
