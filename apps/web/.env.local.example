NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Raw (unencoded) URL to the compiled Bicep template — see infra/bicep/README.md.
NEXT_PUBLIC_BICEP_TEMPLATE_URI=https://raw.githubusercontent.com/satyamamin/CloudGuard/main/infra/bicep/main.json

# Product display name shown in UI text (page titles, headings) — single
# source of truth so the name can change without hunting down every literal
# string. See apps/web/lib/product-name.ts.
NEXT_PUBLIC_PRODUCT_NAME=FinOps Lab
