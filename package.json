{
  "name": "finops-lab",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api-byoc",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/api-byoc && npm run build -w apps/web",
    "build:shared": "npm run build -w packages/shared",
    "check-versions": "node scripts/check-stack-versions.mjs"
  }
}
